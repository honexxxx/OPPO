@startuml
class PointValidator {
    +VALID_COLORS
    +is_valid_color(color: str) : bool
}

class Point2D {
    -x: float
    -y: float
    -color: str
    +__init__(x: float, y: float, color: str)
    +distance_from_origin() : float
    +distance_to(other: Point2D) : float
}

class PointParser {
    -NUMBER_PATTERN
    -COLOR_PATTERN
    +parse(line: str) : Point2D
    -_extract_numbers(line: str) : List[float]
    -_extract_color(line: str) : str
}

class FileReader {
    +read_points(filename: str) : List[Point2D]
    -_read_lines(filename: str)
    -_parse_line(points, line, index)
}

class PointService {
    +sort_by_distance(points: List[Point2D]) : List[Point2D]
    +filter_by_radius(points: List[Point2D], center: Point2D, radius: float) : List[Point2D]
}

class TablePrinter {
    +print(points: List[Point2D])
    -_print_header()
    -_print_rows(points: List[Point2D])
    -_print_row(index: int, point: Point2D)
    -_print_footer(points: List[Point2D])
}

class PointWriter {
    +save(points: List[Point2D], filename: str)
    -_write_points(file, points: List[Point2D])
    -_format_line(index: int, point: Point2D) : str
}

' ===== Связи =====
PointValidator <|-- Point2D
Point2D <|-- PointParser
PointParser <|-- FileReader
Point2D <|-- PointService
Point2D <|-- TablePrinter
Point2D <|-- PointWriter
@enduml
